{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "create-react-app",
  "buildCommand": "react-scripts build",
  "outputDirectory": "build",
  "build": {
    "env": {
      "CI": "false"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://stockpilot-api-tau.vercel.app/api/:path*" },
    { "source": "/", "destination": "/index.html" },
    { "source": "/(auth|auth/callback|update-password|learn|practice|privacy|guide|dashboard|game|game/watchlist|game/goals|game/living-costs|game/advisor|tutorial|leaderboard|rival|achievements|save-load|compare|stocks/[^/]+|profile|level|settings|inbox|news|notifications){/}?", "destination": "/index.html" },
    { "source": "/(.*)", "destination": "/index.html", "statusCode": 404 }
  ]
}
