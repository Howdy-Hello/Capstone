PORT=5000
CLIENT_ORIGIN=http://localhost:3000

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Required in production (16+ random chars). Keys each run's market so the
# visible seed can't be used to compute future prices. Never change it once
# runs exist.
MARKET_SEED_SECRET=

# Optional. Required only for /api/admin/* routes.
ADMIN_API_SECRET=replace-with-a-long-random-secret
