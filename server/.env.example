PORT=5000
CLIENT_ORIGIN=http://localhost:3000

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Required in production: a stable server-only market key (16+ characters).
# Preserve the old derived value if migrating from the credential fallback;
# see DEPLOYMENT.md. Credential rotation must not change active runs' markets.
MARKET_SEED_SECRET=

# Optional. Required only for /api/admin/* routes.
ADMIN_API_SECRET=replace-with-a-long-random-secret
