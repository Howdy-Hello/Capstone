PORT=5000
CLIENT_ORIGIN=http://localhost:3000

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional dedicated market key (16+ random chars). If unset in production,
# a stable key is derived from SUPABASE_SECRET_KEY or SUPABASE_SERVICE_ROLE_KEY.
# Keep the chosen key stable after runs exist; see DEPLOYMENT.md before rotation.
MARKET_SEED_SECRET=

# Optional. Required only for /api/admin/* routes.
ADMIN_API_SECRET=replace-with-a-long-random-secret
